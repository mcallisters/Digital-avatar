# In your Digital-avatar root directory
cat > .gitignore << 'EOF'
# Environment variables
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
*.egg-info/
dist/
build/

# Node/React
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
build/
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo

# Data files (optional - uncomment if you don't want to commit data)
# data/
# *.json
EOF

# Large data files
data/extracted_texts/
data/json_outputs/
*.pdf
*.txt
publications.json" >> .gitignore